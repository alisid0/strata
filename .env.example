# Copy the relevant example to an ignored .env.<mode>.local file.
# Never place a service_role key in a VITE_* variable: VITE_* values are public.
VITE_APP_ENV=staging
VITE_PUBLIC_SITE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-project-anon-key
VITE_ENABLE_TEST_TOOLS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_PHONE_AUTH=false
