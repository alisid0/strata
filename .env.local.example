# .env.local — SERVER-SIDE secrets for the node scripts in scripts/ ONLY.
#
# This file is gitignored and is NOT read by the Vite app build. The app takes
# its VITE_* config from .env.staging.local (dev/staging) and .env.production
# (production). Copy this file to .env.local and fill in real values.
#
# The content-pipeline scripts read these with an explicit env file, e.g.:
#   node --env-file=.env.local scripts/ingest-bbs.mjs
#
# ⚠  POINT SUPABASE AT THE PROJECT YOU ACTUALLY INTEND TO WRITE TO:
#      staging     = atmmfkhjsdqqwnhqifxm
#      production  = wmetdmfsniqrshuaoodc
#    NEVER the retired legacy ref  xzesbcrlnbesmvxmgotp.
#    Use that project's service_role key (Supabase → Settings → API). It bypasses
#    RLS, so keep it out of Git and never put it in a VITE_* variable.

# Supabase (service role — content ingest / sync / audio upload / reports)
SUPABASE_URL=https://<target-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key for that project — NOT the anon key>

# Text-to-speech (scripts/generate-audio.mjs)
ELEVENLABS_API_KEY=<elevenlabs api key>

# Progress-report email (scripts/progress-report.mjs)
GMAIL_APP_PASSWORD=<gmail app password>
REPORT_TO=<recipient email>

# AI bridge (scripts/ai-bridge.mjs), if used
DEEPSEEK_API_KEY=<deepseek api key>
